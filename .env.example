# Copy to .env (never committed). Without a key the display runs with a plain
# black background and no images are generated.

# Google Gemini "Nano Banana" is the default image model ($0.0336 per image).
GEMINI_API_KEY=

# Or use OpenAI GPT Image instead:
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=

# Optional overrides.
# IMAGE_MODEL=gemini-nano-banana-2.1      # or gemini-3.1-flash-lite-image (cheaper), gpt-image-2.5-flare
# IMAGE_QUALITY=medium                   # openai only: low | medium | high
# IMAGE_SIZE=1024x1824                   # openai only, WxH divisible by 16
# IMAGE_STYLE=random                     # random | skyline | poster | lookup

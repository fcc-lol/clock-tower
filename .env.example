# Copy to .env (never committed). Without Google credentials the display runs
# with a plain black background and no images are generated.

# Images come from Gemini Nano Banana on Vertex AI, authenticated with
# Application Default Credentials (no API key). Pick one:
#   a) run once, as the user that runs server.js:
#        gcloud auth application-default login
#   b) point at a service-account key file (if your org allows them):
#        GOOGLE_APPLICATION_CREDENTIALS=/home/pi/clock-tower-sa.json

# The Google Cloud project to bill (needs billing + the Vertex AI API enabled).
GOOGLE_CLOUD_PROJECT=your-project-id

# Optional overrides.
# GOOGLE_CLOUD_LOCATION=global           # nano banana 2.1 is only served from "global"
# IMAGE_MODEL=gemini-nano-banana-2.1      # or gemini-3.1-flash-lite-image (cheaper)
# IMAGE_SIZE=1K                         # 2K is sharper on a 4K panel but ~50% more per image
# IMAGE_STYLE=random                     # random (never repeats the previous slot) or one of the
#                                        # style names in visuals.js: cyberpunk sketchbook isopixel
#                                        # dotmatrix chalkboard crt fieldnotes popart manuscript
#                                        # handheld stencil letterpress

# Optional: let the /styles page generate style previews (each one is billed
# like a live image). Leave unset on a public server: the page is then a
# read-only gallery of whatever `npm run visual:preview` has made.
# STYLE_LAB=1

# Optional: Claude designs the time/weather layout for each image (typeface,
# colors, placement), about 1 cent per image. Without a key the display uses
# the built-in layout for each image style.
# ANTHROPIC_API_KEY=sk-ant-...
# LAYOUT_MODEL=claude-sonnet-5-5

# Copy to .env (never committed). Without a key the display runs with a plain
# black background and no images are generated.

# Google Gemini "Nano Banana" key. gemini-nano-banana-2.1 costs $0.0336 per image.
GEMINI_API_KEY=

# Optional overrides.
# IMAGE_MODEL=gemini-nano-banana-2.1      # or gemini-3.1-flash-lite-image (cheaper)
# IMAGE_STYLE=random                     # random | skyline | poster | lookup
